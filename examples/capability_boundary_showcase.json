      {
        "semantic_layout": "bullets",
        "title": "六个内置图层",
        "content_blocks": [
          {
            "type": "bullets",
            "items": [
              "background 整页背景 · decoration 幽灵圆/logo/分隔线",
              "header 标题栏 · content 要点/卡片/图片",
              "accent 强调条/圆点/连接线 · footer 页脚/页码",
              "图层操作：显隐、z 序重排、重着色、形状归属"
            ]
          }
        ],
        "speaker_notes": "编译器保证六个图层标签，任何生成 Deck 都可按层操作。"
      },
